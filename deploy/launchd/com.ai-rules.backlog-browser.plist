<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ai-rules.backlog-browser</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/ctai/Github/ai-rules/deploy/scripts/run-backlog-browser.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/ctai/.mosaic/logs/ops/launchagent-air-backlog-browser.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ctai/.mosaic/logs/ops/launchagent-air-backlog-browser-err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/ctai</string>
        <key>PATH</key>
        <string>/Users/ctai/.npm-global/bin:/Users/ctai/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>
</dict>
</plist>

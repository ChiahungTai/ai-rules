{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "任務型卡生命週期——卡即 handoff",
    "quality_profile": "showcase"
  },
  "lanes": [
    { "id": "board", "label": "Board 承諾池（進口→出口）" },
    { "id": "work", "label": "Session 執行（接手與分流）" }
  ],
  "phases": [
    { "id": "in", "label": "進口", "fromCol": 0, "toCol": 1 },
    { "id": "take", "label": "承諾與接手", "fromCol": 2, "toCol": 3, "variant": "emphasis" },
    { "id": "out", "label": "結案與出口", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["talk", "create", "card", "open", "small", "close", "done"],
  "nodes": [
    { "id": "talk", "lane": "board", "col": 0, "type": "external", "label": "對話結晶", "sublabel": "討論題·對話即載體", "width": 124 },
    { "id": "draft", "lane": "board", "col": 1, "type": "database", "label": "draft 未承諾池", "sublabel": "觸發型 / session 斷", "width": 124 },
    { "id": "create", "lane": "board", "col": 2, "type": "backend", "label": "建卡 task create", "sublabel": "desc gate 三必有", "tag": "baseline/已決策/驗收", "width": 124 },
    { "id": "card", "lane": "board", "col": 3, "type": "frontend", "label": "卡 To Do", "sublabel": "desc＝決策層", "width": 124 },
    { "id": "close", "lane": "board", "col": 4, "type": "backend", "label": "結案兩步", "sublabel": "Done＋final-summary", "width": 124 },
    { "id": "done", "lane": "board", "col": 5, "type": "database", "label": "Done 欄", "sublabel": "留板→completed/ 清場", "width": 124 },
    { "id": "open", "lane": "work", "col": 3, "type": "security", "label": "起手式五步", "sublabel": "標卡→讀卡→雙 ref", "tag": "規模判定", "width": 124 },
    { "id": "small", "lane": "work", "col": 4, "type": "frontend", "label": "small：卡即 handoff", "sublabel": "desc＋notes 直行", "width": 124, "yOffset": -30 },
    { "id": "ep", "lane": "work", "col": 5, "type": "backend", "label": "standard+：EP", "sublabel": "規劃層→implement", "width": 124, "yOffset": 30 },
    { "id": "drift", "lane": "work", "col": 1, "type": "security", "label": "desc 漂移→修正", "sublabel": "如實化／F-1 回寫 desc", "width": 124 }
  ],
  "edges": [
    { "from": "talk", "to": "create", "label": "拍板承諾", "variant": "emphasis" },
    { "from": "talk", "to": "draft", "label": "session 斷", "role": "branch" },
    { "from": "draft", "to": "create", "label": "promote" },
    { "from": "create", "to": "card" },
    { "from": "card", "to": "open", "label": "「做 AIR-N」" },
    { "from": "open", "to": "small", "label": "small" },
    { "from": "open", "to": "ep", "label": "standard+", "role": "branch" },
    { "from": "small", "to": "close", "label": "執行完成" },
    { "from": "ep", "to": "close", "label": "implement 結算" },
    { "from": "close", "to": "done" },
    { "from": "open", "to": "drift", "label": "快照過時", "role": "error", "variant": "security" }
  ],
  "cards": [
    { "dot": "emerald", "title": "卡即 handoff 契約", "items": ["跨 session To Do 卡 desc 三必有：baseline／已決策勿重辯／驗收", "notes 收接手指針；small 直行、standard+ 建 EP 當主體"] },
    { "dot": "rose", "title": "出口——有進有出", "items": ["結案兩步→卡留 Done 欄；completed/ 清場延到 maintain 週期", "過時卡走 archive/ 退場——可復活（AIR-4 先例）"] },
    { "dot": "cyan", "title": "漂移防護", "items": ["起手式核新鮮度：desc baseline vs git log", "並行搶走→如實化；F-1 型→決策層變更回寫 desc"] }
  ]
}

# macOS
.DS_Store

# Editor backups
*.backup.*
*~

# IDE
.vscode/
.idea/
.zcode/

# Logs
*.log

# Temporary files
.tmp/
*.tmp

# Review & agent work products (ephemeral — see workflow-review-pattern.md / agents/README.md)
.review/
.agent-tmp/
.at-contexts/
STATE.md

# 週日治理看照 cron 趨勢 state（per-rule bytes 基線——活檔 working tree 不進版控，同 nightly-convergence.log 生命週期）
ai-analysis/bundle-watch-state.json

# Python bytecode
__pycache__/
*.pyc

# AI agents
.claude/

# Claude Code settings (contains API keys)
settings.json

# Large / copyrighted reference PDFs (book PDFs in ref-docs/ — do not commit)
ref-docs/*.pdf

.venv

# Python packaging artifacts（code_reality packaged form——uv sync 副產物）
*.egg-info/
.pytest_cache/
.code-review-graph/
.code-reality/

# archify/mermaid 生成產物（illustrate html 模式）——專屬目錄 arch-report/<主題>/（repo root）
# 進 git：JSON IR＋.mmd 源（機器可讀結構快照，可再生產物）＋ visual-check receipt；不進：HTML/SVG（渲染產物）＋截圖
arch-report/**/*.html
arch-report/**/*.svg
arch-report/**/*.visual-check.*.png
# 任務家 archify 產物（_tasks/_projects——illustrate html mode「產物位置分流」）：殼 index.html 手寫進 git；
# 進 git：JSON IR（*.workflow.json 等）＋ visual-check receipt（.visual-check.json）；不進：diagram-*.html（渲染產物）＋截圖＋contact sheet
ai-analysis/_tasks/**/diagram-*.html
ai-analysis/_tasks/**/diagram-*.svg
ai-analysis/_tasks/**/diagram-*.png
ai-analysis/_tasks/**/diagram-*.visual-check.*.png
ai-analysis/_projects/**/diagram-*.html
ai-analysis/_projects/**/diagram-*.svg
ai-analysis/_projects/**/diagram-*.png
ai-analysis/_projects/**/diagram-*.visual-check.*.png
.muse-bridge/
.delegate-bridge/

# machine-local runtime 產物（muse hooks 配置／playwright MCP 截圖——不入版控）
.muse/
.playwright-mcp/

# Muse 共享記憶鎖（ephemeral）
.agents/memory/.muse-memory.lock
.agents/memory/*.lock

# AIR-54 跨池記憶主體（muse project memory 過渡 copy 投影→遷移後池實體）——池自帶 .git（AIR-49 池 git 化），不進本 repo 版控
.agents/memory/
.agents/memory-inbox/

# muse hooks.json 是 machine-local 生成物（絕對路徑無可攜性）——結構源＝hooks/setup-muse-hooks.sh，clone/搬家後重跑
.muse/hooks.json

# probe scratch 備份（F5：T20 運行副產不應進庫）
*.bak
*.bak-*

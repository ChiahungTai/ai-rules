# macOS
.DS_Store

# Editor backups
*.backup.*
*~

# IDE
.vscode/
.idea/
.zcode/

# Logs
*.log

# Temporary files
.tmp/
*.tmp

# Review & agent work products (ephemeral — see workflow-review-pattern.md / agents/README.md)
.review/
.agent-tmp/
.at-contexts/
STATE.md

# Python bytecode
__pycache__/
*.pyc

# AI agents
.claude/

# Claude Code settings (contains API keys)
settings.json

# Large / copyrighted reference PDFs (book PDFs in ref-docs/ — do not commit)
ref-docs/*.pdf

.venv

# Python packaging artifacts（code_reality packaged form——uv sync 副產物）
*.egg-info/
.pytest_cache/
.code-review-graph/
.code-reality/

# archify 生成產物（illustrate html 模式）——專屬目錄 arch-report/<主題>/（repo root）
# 進 git：JSON IR（機器可讀結構快照，~4KB，可再生 HTML）＋ visual-check receipt；不進：HTML（~720KB/顆，內嵌 viewer runtime，git 比例 175:1）＋截圖
arch-report/**/*.html
arch-report/**/*.visual-check.*.png
